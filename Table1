library(tidyverse)

format_log_p_str <- function(log_p_e) {
  log_p_10 <- log_p_e / log(10)
  
  if (log_p_10 > -3) {
    p_val <- 10^log_p_10
    return(sprintf("%.3f", p_val))
  } else {
    exponent <- floor(log_p_10)
    mantissa <- 10^(log_p_10 - exponent)
    return(sprintf("%.4fe%d", mantissa, exponent))
  }
}

calc_cont <- function(data, var_col, label) {
  var_sym <- sym(var_col)
  
  iso_0 <- data %>% filter(isolation == "0") %>% pull(!!var_sym)
  iso_1 <- data %>% filter(isolation == "1") %>% pull(!!var_sym)
  lon_0 <- data %>% filter(loneliness == "0") %>% pull(!!var_sym)
  lon_1 <- data %>% filter(loneliness == "1") %>% pull(!!var_sym)
  
  overall_res <- sprintf("%.2f ± %.2f", mean(data[[var_col]]), sd(data[[var_col]]))
  iso_0_res <- sprintf("%.2f ± %.2f", mean(iso_0), sd(iso_0))
  iso_1_res <- sprintf("%.2f ± %.2f", mean(iso_1), sd(iso_1))
  lon_0_res <- sprintf("%.2f ± %.2f", mean(lon_0), sd(lon_0))
  lon_1_res <- sprintf("%.2f ± %.2f", mean(lon_1), sd(lon_1))
  
  t_iso <- t.test(iso_0, iso_1)
  log_p_iso <- log(2) + pt(-abs(t_iso$statistic), t_iso$parameter, log.p = TRUE)
  p_str_iso <- format_log_p_str(log_p_iso)
  
  t_lon <- t.test(lon_0, lon_1)
  log_p_lon <- log(2) + pt(-abs(t_lon$statistic), t_lon$parameter, log.p = TRUE)
  p_str_lon <- format_log_p_str(log_p_lon)
  
  tibble(
    Variable = label,
    Overall = overall_res,
    `No SI` = iso_0_res, `SI` = iso_1_res, `P_SI` = p_str_iso,
    `No Loneliness` = lon_0_res, `Loneliness` = lon_1_res, `P_Lon` = p_str_lon
  )
}

calc_cat <- function(data, var_col, label, target_level = NULL) {
  
  t_overall <- table(data[[var_col]])
  t_iso     <- table(data[[var_col]], data$isolation)
  t_lon     <- table(data[[var_col]], data$loneliness)
  
  c_iso <- chisq.test(t_iso)
  c_lon <- chisq.test(t_lon)
  
  log_p_iso <- pchisq(c_iso$statistic, c_iso$parameter, lower.tail = FALSE, log.p = TRUE)
  log_p_lon <- pchisq(c_lon$statistic, c_lon$parameter, lower.tail = FALSE, log.p = TRUE)
  
  p_str_iso <- format_log_p_str(log_p_iso)
  p_str_lon <- format_log_p_str(log_p_lon)
  
  levels_vec <- if (!is.null(target_level)) target_level else levels(data[[var_col]])
  out_list <- list()
  
  for (lvl in levels_vec) {
    n_o <- t_overall[lvl]; p_o <- prop.table(t_overall)[lvl] * 100
    n_i0 <- t_iso[lvl, "0"]; p_i0 <- prop.table(t_iso, 2)[lvl, "0"] * 100
    n_i1 <- t_iso[lvl, "1"]; p_i1 <- prop.table(t_iso, 2)[lvl, "1"] * 100
    n_l0 <- t_lon[lvl, "0"]; p_l0 <- prop.table(t_lon, 2)[lvl, "0"] * 100
    n_l1 <- t_lon[lvl, "1"]; p_l1 <- prop.table(t_lon, 2)[lvl, "1"] * 100
    
    row_label <- if (length(levels_vec) == 1) label else paste0("  ", lvl)
    cur_p_si  <- if (lvl == levels_vec[1]) p_str_iso else ""
    cur_p_lon <- if (lvl == levels_vec[1]) p_str_lon else ""
    
    out_list[[lvl]] <- tibble(
      Variable = row_label,
      Overall = sprintf("%s (%.0f%%)", format(n_o, big.mark=","), p_o),
      `No SI` = sprintf("%s (%.0f%%)", format(n_i0, big.mark=","), p_i0),
      `SI` = sprintf("%s (%.0f%%)", format(n_i1, big.mark=","), p_i1),
      `P_SI` = cur_p_si,
      `No Loneliness` = sprintf("%s (%.0f%%)", format(n_l0, big.mark=","), p_l0),
      `Loneliness` = sprintf("%s (%.0f%%)", format(n_l1, big.mark=","), p_l1),
      `P_Lon` = cur_p_lon
    )
  }
  
  if (is.null(target_level)) {
    header_row <- tibble(
      Variable = label, Overall = "", `No SI` = "", `SI` = "", `P_SI` = p_str_iso,
      `No Loneliness` = "", `Loneliness` = "", `P_Lon` = p_str_lon
    )
    rows <- bind_rows(out_list) %>% mutate(P_SI = "", P_Lon = "")
    return(bind_rows(header_row, rows))
  } else {
    return(bind_rows(out_list))
  }
}

df <- cmp_incident %>%
  dplyr::select(
    isolation, loneliness, Age, Sex, Race, UK_Center, Employment, 
    Education, Income, Smoking_status, Alcohol_status, Family_cancer, 
    Townsend_deprivation_index, day_exposure, diet_score, sleep_score, 
    depress_mood, BMI, MAP, Hand_grip, Overall_health_rating
  ) %>%
  drop_na() %>%
  mutate(
    isolation = as.factor(isolation),
    loneliness = as.factor(loneliness),
    Sex = factor(Sex, levels = c("Female", "Male")),
    Race = factor(Race, levels = c("Non white", "White")),
    Family_cancer = as.factor(Family_cancer)
  )

row_age   <- calc_cont(df, "Age", "Age, years")
row_tdi   <- calc_cont(df, "Townsend_deprivation_index", "Townsend Deprivation Score")
row_sun   <- calc_cont(df, "day_exposure", "Sun exposure time, hours/day")
row_diet  <- calc_cont(df, "diet_score", "Diet Score")
row_sleep <- calc_cont(df, "sleep_score", "Sleep Score")
row_bmi   <- calc_cont(df, "BMI", "BMI (kg/m2)")
row_map   <- calc_cont(df, "MAP", "MAP (mmHg)")
row_grip  <- calc_cont(df, "Hand_grip", "Grip strength, kg")
row_health <- calc_cont(df, "Overall_health_rating", "Overall Health Rating")

row_sex    <- calc_cat(df, "Sex", "Sex, Male, n (%)", target_level = "Male")
row_race   <- calc_cat(df, "Race", "Ethnicity, White, n (%)", target_level = "White")
row_center <- calc_cat(df, "UK_Center", "Assessment Center")
row_employ <- calc_cat(df, "Employment", "Employment")
row_edu    <- calc_cat(df, "Education", "College/university degree, n (%)", target_level = "College/university degree")
row_income <- calc_cat(df, "Income", "Income")
row_smoke  <- calc_cat(df, "Smoking_status", "Smoking status")
row_drink  <- calc_cat(df, "Alcohol_status", "Alcohol status")
row_fam_ca <- calc_cat(df, "Family_cancer", "Family cancer history, n (%)", target_level = "1")
row_depress <- calc_cat(df, "depress_mood", "Depress mood")

final_table <- bind_rows(
  row_age, row_sex, row_race, row_center, row_employ, row_edu,
  row_income, row_smoke, row_drink, row_fam_ca,
  row_tdi, row_sun, row_diet, row_sleep, row_depress,
  row_bmi, row_map, row_grip, row_health
)

n_ov <- nrow(df); n_nsi <- sum(df$isolation=="0"); n_si <- sum(df$isolation=="1")
n_nl <- sum(df$loneliness=="0"); n_l <- sum(df$loneliness=="1")

