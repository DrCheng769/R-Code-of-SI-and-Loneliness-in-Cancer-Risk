    if (!is.na(lr_stat) && lr_stat >= 0) {
      p_inter <- pchisq(lr_stat, df_diff, lower.tail = FALSE)
    }
  }
  
  for (level in levels_subgroup) {
    RERI <- NA
    RERI_lower <- NA
    RERI_upper <- NA
    if (level != ref_level) {
      filter_expr_level <- paste0(subgroup, " == '", level, "' | ", subgroup, " == '", ref_level, "'")
      data_subset_level <- aaa_doubt %>% filter(eval(parse(text = filter_expr_level))) %>% na.omit() %>% droplevels()
      data_subset_level[[subgroup]] <- factor(data_subset_level[[subgroup]], levels = c(ref_level, level))
      
      covars <- setdiff(covariates_base, subgroup)
      num_cov <- length(covars)
      formula_level <- as.formula(paste("Crisk(delta_years, indicator) ~ isolation *", subgroup, "+", paste(covars, collapse = " + ")))
      fg_model_level <- tryCatch(
        fastCrr(formula_level, data = data_subset_level, variance = TRUE),
        error = function(e) {
          NULL
        }
      )
      
      if (!is.null(fg_model_level)) {
        num_levels <- 2
        expected_coef <- 1 + (num_levels - 1) + num_cov + 1
        idx_isolation <- 1
        idx_subgroup <- 2
        idx_interaction <- num_cov + 3
        if (length(fg_model_level$coef) >= idx_interaction) {
          coef_isolation <- fg_model_level$coef[idx_isolation]
          coef_subgroup <- fg_model_level$coef[idx_subgroup]
          coef_interaction <- fg_model_level$coef[idx_interaction]
          sHR11 <- exp(coef_isolation + coef_subgroup + coef_interaction)
          sHR10 <- exp(coef_isolation)
          sHR01 <- exp(coef_subgroup)
          RERI <- sHR11 - sHR10 - sHR01 + 1
          
          var_isolation <- fg_model_level$var[idx_isolation, idx_isolation]
          var_subgroup <- fg_model_level$var[idx_subgroup, idx_subgroup]
          var_interaction <- fg_model_level$var[idx_interaction, idx_interaction]
          cov_isolation_subgroup <- fg_model_level$var[idx_isolation, idx_subgroup]
          cov_isolation_interaction <- fg_model_level$var[idx_isolation, idx_interaction]
          cov_subgroup_interaction <- fg_model_level$var[idx_subgroup, idx_interaction]
          
          var_sHR11 <- sHR11^2 * (var_isolation + var_subgroup + var_interaction +
                                    2 * cov_isolation_subgroup + 2 * cov_isolation_interaction +
                                    2 * cov_subgroup_interaction)
          var_sHR10 <- sHR10^2 * var_isolation
          var_sHR01 <- sHR01^2 * var_subgroup
          cov_sHR11_sHR10 <- sHR11 * sHR10 * (var_isolation + cov_isolation_subgroup + cov_isolation_interaction)
          cov_sHR11_sHR01 <- sHR11 * sHR01 * (cov_isolation_subgroup + var_subgroup + cov_subgroup_interaction)
          cov_sHR10_sHR01 <- sHR10 * sHR01 * cov_isolation_subgroup
          
          var_RERI <- var_sHR11 + var_sHR10 + var_sHR01 -
            2 * cov_sHR11_sHR10 - 2 * cov_sHR11_sHR01 + 2 * cov_sHR10_sHR01
          se_RERI <- sqrt(var_RERI)
          
          RERI_lower <- RERI - 1.96 * se_RERI
          RERI_upper <- RERI + 1.96 * se_RERI
        }
      }
    }
    
    interaction_df_isolation <- rbind(
      interaction_df_isolation,
      data.frame(
        Subgroup = subgroup,
        Level = as.character(level),
        P_for_interaction = round(p_inter, 5),
        RERI = round(RERI, 5),
        RERI_lower = round(RERI_lower, 5),
        RERI_upper = round(RERI_upper, 5),
        stringsAsFactors = FALSE
      )
    )
  }
}

