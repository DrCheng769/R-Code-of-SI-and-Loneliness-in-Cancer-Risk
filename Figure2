process_joint_model <- function(formula, model_name) {
  fg_model <- tryCatch(
    fastCrr(formula, data = data_try, variance = TRUE),
    error = function(e) { NULL }
  )
  
  if (!is.null(fg_model)) {
    saved_models[[model_name]] <<- fg_model
    
    res_list <- list()
    for(i in 1:3) {
      sHR <- exp(fg_model$coef[i])
      SE_log <- sqrt(fg_model$var[i, i])
      CI_L <- exp(fg_model$coef[i] - 1.96 * SE_log)
      CI_U <- exp(fg_model$coef[i] + 1.96 * SE_log)
      p_raw <- 2 * (1 - pnorm(abs(fg_model$coef[i] / SE_log)))
      
      res_list[[i]] <- list(sHR = sHR, CI = paste0("[", round(CI_L, 3), "-", round(CI_U, 3), "]"), p_value = as.character(p_raw))
    }
    return(res_list)
  } else {
    return(list(
      list(sHR=NA, CI="NA", p_value="NA"),
      list(sHR=NA, CI="NA", p_value="NA"),
      list(sHR=NA, CI="NA", p_value="NA")
    ))
  }
}

