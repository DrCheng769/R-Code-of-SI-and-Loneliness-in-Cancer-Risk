calculate_cox <- function(data, filter_expr, group_var, covariates, model_name_key) {
  data_filtered <- data %>% filter(eval(parse(text = filter_expr))) %>% na.omit()
  
  formula <- as.formula(paste("Surv(delta_years, status_cox) ~", paste(c(group_var, covariates), collapse = " + ")))
  
  cox_model <- tryCatch(
    coxph(formula, data = data_filtered),
    error = function(e) { NULL }
  )
  
  if (is.null(cox_model)) {
    return(list(HR = NA, CI = "NA", CI_lower = NA, CI_upper = NA, p_value = "NA"))
  }
  
  saved_models[[model_name_key]] <<- cox_model
  
  summ <- summary(cox_model)
  coef_stats <- summ$coefficients[group_var, , drop = FALSE]
  conf_stats <- summ$conf.int[group_var, , drop = FALSE]
  
  HR <- coef_stats[1, "exp(coef)"]
  p_value_raw <- coef_stats[1, "Pr(>|z|)"]
  CI_lower <- conf_stats[1, "lower .95"]
  CI_upper <- conf_stats[1, "upper .95"]
  
  list(HR = HR, 
       CI = paste0("[", round(CI_lower, 3), "-", round(CI_upper, 3), "]"),
       CI_lower = CI_lower, 
       CI_upper = CI_upper, 
       p_value = p_value_raw)
}

calculate_paf <- function(hr, cases, total) {
  if (is.na(hr) || length(hr) == 0 || is.nan(hr) || is.infinite(hr)) {
    return(list(paf = NA))
  }
  paf <- ((hr - 1) / hr) * (cases / total)
  list(paf = round(paf * 100, 3))
}

