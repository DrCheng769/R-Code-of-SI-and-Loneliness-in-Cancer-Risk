process_joint_model_cox <- function(formula, model_name) {
  cox_model <- tryCatch(
    coxph(formula, data = data_try),
    error = function(e) { NULL }
  )
  
  if (!is.null(cox_model)) {
    saved_models[[model_name]] <<- cox_model
    
    summ <- summary(cox_model)
    vars <- paste0("exposure_count_factor", 2:4)
    
    res_list <- list()
    for(v in vars) {
      if(v %in% rownames(summ$coefficients)) {
        HR <- summ$coefficients[v, "exp(coef)"]
        CI_L <- summ$conf.int[v, "lower .95"]
        CI_U <- summ$conf.int[v, "upper .95"]
        p_val <- summ$coefficients[v, "Pr(>|z|)"]
        res_list[[length(res_list)+1]] <- list(HR = HR, CI = paste0("[", round(CI_L, 3), "-", round(CI_U, 3), "]"), p_value = as.character(p_val))
      } else {
        res_list[[length(res_list)+1]] <- list(HR=NA, CI="NA", p_value="NA")
      }
    }
    return(res_list)
  } else {
    return(rep(list(list(HR=NA, CI="NA", p_value="NA")), 3))
  }
}

