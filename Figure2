process_continuous_model_cox <- function(formula, model_name) {
  cox_model <- tryCatch(coxph(formula, data = data_try), error = function(e) { NULL })
  
  if(!is.null(cox_model)) {
    saved_models[[model_name]] <<- cox_model
    summ <- summary(cox_model)
    if("exposure_count" %in% rownames(summ$coefficients)) {
      HR <- summ$coefficients["exposure_count", "exp(coef)"]
      CI_L <- summ$conf.int["exposure_count", "lower .95"]
      CI_U <- summ$conf.int["exposure_count", "upper .95"]
      p_val <- summ$coefficients["exposure_count", "Pr(>|z|)"]
      return(list(HR = HR, CI_lower = CI_L, CI_upper = CI_U, p_value = as.character(p_val)))
    }
  }
  return(list(HR = NA, CI_lower=NA, CI_upper=NA, p_value = "NA"))
}

