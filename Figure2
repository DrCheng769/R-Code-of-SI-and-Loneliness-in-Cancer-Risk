process_continuous_model <- function(formula, model_name) {
  fg_model <- tryCatch(
    fastCrr(formula, data = data_try, variance = TRUE),
    error = function(e) { NULL }
  )
  
  if(!is.null(fg_model)) {
    saved_models[[model_name]] <<- fg_model
    
    sHR <- exp(fg_model$coef[1])
    SE <- sqrt(fg_model$var[1,1])
    CI_L <- exp(fg_model$coef[1] - 1.96 * SE)
    CI_U <- exp(fg_model$coef[1] + 1.96 * SE)
    p_raw <- 2 * (1 - pnorm(abs(fg_model$coef[1] / SE)))
    
    return(list(sHR = sHR, CI_lower = CI_L, CI_upper = CI_U, p_value = as.character(p_raw)))
  } else {
    return(list(sHR = NA, CI_lower=NA, CI_upper=NA, p_value = "NA"))
  }
}

